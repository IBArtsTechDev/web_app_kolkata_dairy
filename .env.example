# Environment Variables
# Copy this file to .env.local and fill in the values

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Firebase Web App Credentials (push notifications only — no Google sign-in)
# apiKey / authDomain / projectId / appId identify the web app for FCM getToken()
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging (Web Push)
# Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
